# Copy this file to .env and replace the placeholder values.
# Prefer IAM roles or AWS profiles over long-lived access keys when possible.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Set this only when using temporary credentials (for example, AWS SSO or STS).
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
